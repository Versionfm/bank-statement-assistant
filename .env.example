BSA_DATABASE_URL=postgresql+psycopg://bank_statement_assistant:replace-me@127.0.0.1:5432/bank_statement_assistant
BSA_STATEMENT_FILES_PATH=./data/statements
BSA_STATIC_FILES_PATH=./frontend/dist
BSA_LOG_LEVEL=INFO
BSA_WORKER_POLL_SECONDS=1
BSA_JOB_RETRY_DELAY_SECONDS=5
BSA_JOB_MAX_ATTEMPTS=3
BSA_JOB_LEASE_SECONDS=1000
BSA_JOB_HANDLER_TIMEOUT_SECONDS=900
BSA_APPLICATION_VERSION=0.1.0
BSA_MAX_PDF_BYTES=15728640
BSA_MAX_PDF_PAGES=50
# Optional local-only fixture used by scripts/deploy-k3s.sh parser verification.
# BSA_PRIVATE_BPI_FIXTURE=./BPI_2025-09.pdf
BSA_CLASSIFICATION_RESEARCH_ENABLED=false
# disabled, brave, or browser. Browser mode requires Playwright Chromium.
BSA_SEARCH_PROVIDER=brave
BSA_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
# BSA_SEARCH_API_KEY=
BSA_SEARCH_TIMEOUT_SECONDS=8
BSA_SEARCH_MAX_RESULTS=5
BSA_SEARCH_CACHE_TTL_SECONDS=604800
BSA_BROWSER_SEARCH_BASE_URL=https://html.duckduckgo.com/html/
BSA_BROWSER_SEARCH_TIMEOUT_SECONDS=20
# BSA_BROWSER_SEARCH_EXECUTABLE_PATH=
